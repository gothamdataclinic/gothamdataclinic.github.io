# ============================================================
# Gotham Data Clinic CMS — Environment Variables
# Copy this file to .env and fill in the values
# ============================================================

# A long random secret string — CHANGE THIS before going live!
# Generate one at: https://generate-secret.vercel.app/32
PAYLOAD_SECRET=

# The URL of your live website (used for CORS + live-preview links)
SITE_URL=https://gothamdataclinic.org

# Supabase Postgres connection string (session pooler, port 5432 — NOT the
# transaction pooler on 6543, which breaks Payload's prepared-statement use).
# Get this at Supabase Dashboard > Project Settings > Database.
DATABASE_URL=postgresql://postgres.hfzcajwujpczyzlfsytx:<password>@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# Supabase Storage (S3-compatible). The `media` bucket is created and made
# public via the Supabase Dashboard — these are just the access credentials
# for it, from Project Settings > Storage > S3 Connection.
SUPABASE_S3_ENDPOINT=https://hfzcajwujpczyzlfsytx.supabase.co/storage/v1/s3
SUPABASE_S3_REGION=us-east-1
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=
SUPABASE_STORAGE_BUCKET=media

# Port the CMS runs on (default: 3000 for Next.js)
# PORT=3000

# Supabase project — used for Google Workspace admin login via Supabase Auth.
# NEXT_PUBLIC_* vars are safe to expose to the browser (anon key only).
NEXT_PUBLIC_SUPABASE_URL=https://hfzcajwujpczyzlfsytx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Google sign-in itself is configured in the Supabase Dashboard
# (Authentication > Providers > Google), which still requires a Google Cloud
# OAuth Client ID/Secret — just registered against Supabase's own callback
# URL (https://hfzcajwujpczyzlfsytx.supabase.co/auth/v1/callback), not ours.
# Nothing to set here for that part.
ALLOWED_EMAIL_DOMAIN=gothamdataclinic.org
